# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/yieldagent/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/yieldagent-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/yieldagent-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# YIELDAGENT_LISTEN=127.0.0.1:63050
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# YIELDAGENT_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/yieldagent.service) less the pool and some headroom.
# YIELDAGENT_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# YIELDAGENT_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# YIELDAGENT_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# YIELDAGENT_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# YIELDAGENT_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# YIELDAGENT_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/yieldagent-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# YIELDAGENT_REQUEST_TIMEOUT_MS=5000
# YIELDAGENT_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# YIELDAGENT_MAX_IN_FLIGHT=64

# --- Database (crates/yieldagent-db) ------------------------------------------------------
# YIELDAGENT_DB_MAX_CONNECTIONS=16
# YIELDAGENT_DB_ACQUIRE_TIMEOUT_MS=2000
# YIELDAGENT_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# YIELDAGENT_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# YIELDAGENT_STARTUP_TIMEOUT_MS=30000

# --- Market data worker (crates/yieldagent-markets), read-only -------------------------
# The public DefiLlama yields endpoint; empty turns the worker off (the reads still serve
# what is stored). Production: https://yields.llama.fi/pools. Plain http only on loopback.
# YIELDAGENT_DEFILLAMA_URL=
# One round per interval; the fetch deadline must be below it.
# YIELDAGENT_FETCH_INTERVAL_S=300
# YIELDAGENT_FETCH_TIMEOUT_MS=20000
# The source body cap (the live body was about 10 MB at M1).
# YIELDAGENT_SOURCE_MAX_BODY_BYTES=33554432
# A snapshot older than this is stale (END_GOAL Case 5: 15 minutes).
# YIELDAGENT_SNAPSHOT_MAX_AGE_S=900

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least YIELDAGENT_ERROR_MIN_REQUESTS were answered.
# YIELDAGENT_ERROR_RATE_PERMILLE=50
# YIELDAGENT_ERROR_MIN_REQUESTS=20
# YIELDAGENT_LOG=info
# json for journald; text for a terminal.
# YIELDAGENT_LOG_FORMAT=json

# --- Accounts (crates/yieldagent-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# YIELDAGENT_SMTP_RELAY=
# YIELDAGENT_MAIL_FROM=noreply@defi-yield-agent.invalid
# Where links in emails point.
# YIELDAGENT_PUBLIC_URL=http://127.0.0.1:63050
# YIELDAGENT_COOKIE_SECURE=true
# YIELDAGENT_SESSION_TTL_S=604800
# YIELDAGENT_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# YIELDAGENT_TRUSTED_PROXIES=
# YIELDAGENT_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# YIELDAGENT_PLAN_MAX_MEMBERS=10
# YIELDAGENT_PLAN_MAX_TOKENS=10
# YIELDAGENT_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/yieldagent/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role yieldagent_app
#   migration-database-url  yieldagentctl migrate, digests, fingerprint, prune-events (yieldagent_owner)
#   admin-database-url      yieldagentctl bootstrap only
#   owner-password          yieldagentctl bootstrap only
#   app-password            yieldagentctl bootstrap only
# YIELDAGENT_DATABASE_URL_FILE=/etc/yieldagent/credentials/database-url
# YIELDAGENT_MIGRATION_DATABASE_URL_FILE=/etc/yieldagent/credentials/migration-database-url
# YIELDAGENT_ADMIN_DATABASE_URL_FILE=/etc/yieldagent/credentials/admin-database-url
# YIELDAGENT_OWNER_PASSWORD_FILE=/etc/yieldagent/credentials/owner-password
# YIELDAGENT_APP_PASSWORD_FILE=/etc/yieldagent/credentials/app-password
